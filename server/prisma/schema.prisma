generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  message Message[]
}

model Room {
  id           String   @id @default(cuid())
  secretNumber Int?
  createdAt    DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  content   String
  room      String
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  @@index([room])
}
