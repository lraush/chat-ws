# Copy to .env and adjust.

DATABASE_URL="mysql://root@localhost:3306/chat_ws"

# Required in production — long random string
JWT_SECRET=change-me-in-production

# First admin (created once on server start if no such user exists)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# LanguageTool (optional — defaults to free public API)
# Premium: https://api.languagetoolplus.com/v2
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2
# LANGUAGETOOL_USERNAME=
# LANGUAGETOOL_API_KEY=
